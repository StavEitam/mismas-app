rules_version = '2';

// Per-collection rules for the MISMAS MVP schema.
// See docs/superpowers/specs/2026-08-14-mismas-app-design.md Sections 4 & 6.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // True if the update only touches fields in `allowedFields`.
    function onlyChanges(allowedFields) {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(allowedFields);
    }

    // True only for the account(s) granted admin access — set manually via
    // the console only, no client-side self-elevation path exists (see the
    // users/{userId} rule below).
    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // users/{userId} — a user can read/write only their own doc.
    // `status` (moderation flag) and `isAdmin` can never be changed by the
    // client — only via the Firebase console/Admin SDK.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.status == 'active'
        && request.resource.data.isAdmin == false;
      allow update: if isOwner(userId)
        && request.resource.data.status == resource.data.status
        && request.resource.data.isAdmin == resource.data.isAdmin;
      allow delete: if false;
    }

    // events/{eventId} — readable by any signed-in guest. Writable only by
    // an admin, from the in-app Admin screen (spec Section 4) — this is
    // enforced server-side by the rule itself, not trusted from the client.
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // True only once an admin has manually flipped `revealed`, per the
    // manual-only reveal trigger (spec Section 4). Used to let the Reveal
    // screen read *other* guests' checked-in tickets.
    function eventRevealed(eventId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/events/$(eventId)).data.revealed == true;
    }

    // tickets/{ticketId} — a user always has full read access to their own
    // tickets; an admin can read any ticket (needed for the pending-approval
    // list). Any *other* guest's ticket becomes readable only once it's
    // checked-in AND the event has been revealed (powers the Reveal
    // screen). A user can create only their own ticket, starting as
    // approvalStatus 'pending'. From there, the guest can only ever flip
    // checkedIn/checkedInAt on it (PIN check-in), and only once an admin
    // has set approvalStatus to 'approved'; only an admin can change
    // approvalStatus itself. purchaseStatus, userId, eventId,
    // consentAccepted are immutable from the client once created. No
    // selfie feature in this MVP — Reveal uses only users.photoUrl or the
    // branded fallback avatar.
    match /tickets/{ticketId} {
      allow read: if isOwner(resource.data.userId)
        || isAdmin()
        || (resource.data.checkedIn == true && eventRevealed(resource.data.eventId));
      allow create: if isOwner(request.resource.data.userId)
        && request.resource.data.checkedIn == false
        && request.resource.data.approvalStatus == 'pending';
      allow update: if
        (isOwner(resource.data.userId)
          && onlyChanges(['checkedIn', 'checkedInAt'])
          && resource.data.approvalStatus == 'approved')
        || (isAdmin() && onlyChanges(['approvalStatus']));
      allow delete: if false;
    }

    // Everything else stays locked down.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
