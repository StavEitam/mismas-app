rules_version = '2';

// Phase 1 baseline: everything locked down by default.
// Phase 2 replaces this with per-collection rules for users/events/tickets
// per docs/superpowers/specs/2026-08-14-mismas-app-design.md Section 6.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
