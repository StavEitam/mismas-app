rules_version = '2';

// Storage is unused in this MVP — the Selfie Check-in feature was dropped
// to stay on Firebase's free Spark plan (Storage requires Blaze). Left
// locked down as a safe default in case Storage is revisited later.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
